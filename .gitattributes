# Keep LF in the working tree. Git was converting these to CRLF on checkout,
# which silently broke multi-line edits and the build script's string
# handling. The iOS build and the PowerShell build script both expect LF.
*               text=auto eol=lf
*.html          text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.json          text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
*.ps1           text eol=lf
*.swift         text eol=lf
*.plist         text eol=lf
*.pbxproj       text eol=lf
*.xcscheme      text eol=lf
Dockerfile      text eol=lf

# binary
*.png           binary
*.jpg           binary
*.pdf           binary
*.woff2         binary
