# dependencies
node_modules/

# regenerated by `npx cap sync ios` during the build
ios/App/App/public/

# iOS build output
ios/App/build/
ios/App/Pods/
ios/App/output/
DerivedData/
*.xcuserstate
xcuserdata/
*.ipa
*.dSYM.zip

# Apple signing material - NEVER commit these. The .p8 API key in particular
# can only be downloaded once from App Store Connect. It belongs in Codemagic,
# not in the repo.
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
AuthKey_*
*.pem
*.key
certificate_private_key*

# machine-local editor settings
.claude/settings.local.json

# local scratch
.DS_Store
Thumbs.db
